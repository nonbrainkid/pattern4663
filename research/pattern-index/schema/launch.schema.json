{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pattern.invalid/schema/launch.schema.json",
  "title": "PATTERN INDEX normalized launch record v0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "data_status", "is_synthetic", "chain", "token_address",
    "pool_address", "quote_token_address", "dex_project", "universe_source",
    "t0", "t0_definition", "observations"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "data_status": {"enum": ["synthetic", "observed", "partial"]},
    "is_synthetic": {"type": "boolean"},
    "chain": {"type": "string", "minLength": 1},
    "token_address": {"$ref": "#/$defs/address"},
    "pool_address": {"$ref": "#/$defs/address"},
    "quote_token_address": {"$ref": "#/$defs/address"},
    "factory_address": {"anyOf": [{"$ref": "#/$defs/address"}, {"type": "null"}]},
    "dex_project": {"type": "string", "minLength": 1},
    "universe_source": {
      "enum": ["dex_trades_first_seen", "factory_pool_created", "synthetic_demo"]
    },
    "t0": {"type": "string", "format": "date-time"},
    "t0_definition": {"type": "string", "minLength": 1},
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["swaps", "liquidity", "traders"],
      "properties": {
        "swaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timestamp", "trader", "side", "amount_usd"],
            "properties": {
              "timestamp": {"type": "string", "format": "date-time"},
              "tx_hash": {"type": "string"},
              "trader": {"$ref": "#/$defs/address"},
              "side": {"enum": ["buy", "sell", "unknown"]},
              "amount_usd": {"type": "number", "minimum": 0}
            }
          }
        },
        "liquidity": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timestamp", "liquidity_usd"],
            "properties": {
              "timestamp": {"type": "string", "format": "date-time"},
              "liquidity_usd": {"type": "number", "minimum": 0}
            }
          }
        },
        "traders": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["timestamp", "address"],
            "properties": {
              "timestamp": {"type": "string", "format": "date-time"},
              "address": {"$ref": "#/$defs/address"}
            }
          }
        }
      }
    },
    "outcome_30d": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_end", "cumulative_volume_usd", "max_liquidity_usd",
        "last_trade_at", "success_label", "label_status"
      ],
      "properties": {
        "window_end": {"type": "string", "format": "date-time"},
        "cumulative_volume_usd": {"type": ["number", "null"], "minimum": 0},
        "max_liquidity_usd": {"type": ["number", "null"], "minimum": 0},
        "last_trade_at": {"type": ["string", "null"], "format": "date-time"},
        "success_label": {"type": ["integer", "null"], "enum": [0, 1, null]},
        "label_status": {
          "enum": ["draft_synthetic", "observed_unlocked", "observed_locked", "missing"]
        }
      }
    }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^(0x[0-9a-fA-F]{40}|synthetic:[a-z0-9:_-]+)$"
    }
  }
}

